PORT=8787
TRADE_DB_PATH=./data/trades.sqlite
# Server-only credentials. Never use EXPO_PUBLIC_ for these.
X_BEARER_TOKEN=
TRADE_ADMIN_TOKEN=
# Set if Expo enhanced push security is enabled for this EAS project.
EXPO_ACCESS_TOKEN=
# Worker cadence; Friedman is checked every minute, RSS every five minutes.
POLL_INTERVAL_MS=60000
# Peer IP of the reverse proxy in front of this service; its X-Forwarded-For is then used for rate limiting.
TRUSTED_PROXY=
